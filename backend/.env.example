# Supabase PostgreSQL Connection String (Pooler recommended for IPv4)
# Example: postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your_project:your_password@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Server Port
PORT=3000

# Nodemailer Alert Configuration (Optional)
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_EMAIL_TO=
